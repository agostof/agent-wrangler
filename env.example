CALLER_UID=1000
CALLER_GID=1000
WORKSPACE=./workspace
PROJECTS=${HOME}/Projects

# Set to true to recursively chown /home/agent or /work on container startup
CHOWN_AGENT_HOME=false
CHOWN_WORK=false

# Container restart policy: no (default) or unless-stopped.
# unless-stopped keeps a `docker compose up -d` container running across
# Docker daemon / host restarts.
RESTART_POLICY=no

# tmux inside the container (see config/tmux.conf)
# Default prefix for new tmux servers; empty = C-b. Use e.g. C-a if you run the
# container's tmux inside a host tmux. Per session: connect_as_agent_user.sh --prefix
TMUX_PREFIX=
# true = save tmux sessions every 15 min and restore them when tmux starts again
TMUX_RESURRECT=false

CLAUDE_DOT_DIR=${HOME}/UserData/.opt/.claude
CLAUDE_CONFIG=${HOME}/UserData/.opt/.claude.json
CLAUDE_STATE_DIR=${HOME}/UserData/.opt/claude/state/claude

CODEX_DOT_DIR=${HOME}/UserData/.opt/.codex
ANTIGRAVITY_DOT_DIR=${HOME}/UserData/.opt/.gemini/antigravity-cli
